# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Server Configuration (optional)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Gemini Model Settings (optional)
GEMINI_MODEL=gemini-live-2.5-flash-preview
GEMINI_VOICE=Puck  # Options: Puck, Charon, Kore, Fenrir, Aoede

# Conversation Settings (optional)
ENABLE_INTERRUPTIONS=true
VAD_THRESHOLD=0.5
EMOTION_SMOOTHING=0.7
MAX_CONVERSATION_HISTORY=20
CONTEXT_WINDOW=10
SESSION_TIMEOUT=300  # seconds

# Ditto Settings (optional)
DITTO_CFG_PKL=outputs/cfg_f_model.pkl
DITTO_DATA_ROOT=./
DITTO_SOURCE=examples/avatar.jpg
DITTO_MAX_SIZE=1920
DITTO_CROP_SCALE=2.3
DITTO_EMOTION=4  # 0=happy, 4=neutral
